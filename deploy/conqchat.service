# systemd keeps the app running: starts it at boot and restarts it if it crashes.
# __APP_DIR__ and __USER__ are filled in by setup.sh.
[Unit]
Description=ConqChat (FastAPI + uvicorn)
After=network.target postgresql.service

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
# Listen only on localhost: the outside world must go through nginx
ExecStart=__APP_DIR__/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
